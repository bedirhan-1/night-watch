# Zorunlu
DATABASE_URL=            # Vercel > Storage > Neon eklenince otomatik gelir
APP_PASSWORD=            # Panoya giriş şifresi
CRON_SECRET=             # Rastgele uzun bir değer; Vercel cron isteğini doğrular

# Mail (Resend)
RESEND_API_KEY=
MAIL_FROM=               # Örn. "Bikort Takip <takip@alanadin.com>". Boşsa onboarding@resend.dev kullanılır
NOTIFY_EMAIL=            # Varsayılan alıcı; Ayarlar ekranından değiştirilebilir
APP_URL=                 # Örn. https://bikort-takip.vercel.app (maildeki bağlantı için)

# İsteğe bağlı
APP_TZ=Europe/Istanbul
DEFAULT_OWNER=           # Otomatik açılan kayıtların sorumlusu

# Vercel derlemeleri
VERCEL_TOKEN=
VERCEL_TEAM_ID=          # Takım hesabıysa

# GitHub Actions
GITHUB_TOKEN=            # actions:read ve metadata:read yetkili fine-grained token
GITHUB_REPOS=            # Virgülle: sahip/depo,sahip/depo2

# App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=         # .p8 dosyasının içeriği (satır sonları \n olabilir)
ASC_APP_ID=              # Boşsa hesaptaki tüm uygulamalar

# AWS (salt okunur IAM kullanıcısı; IAMReadOnlyAccess yeterli)
BIKORT_AWS_ACCESS_KEY_ID=
BIKORT_AWS_SECRET_ACCESS_KEY=
