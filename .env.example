# Hepsi zorunlu
DATABASE_URL=            # Vercel > Storage > Neon eklenince otomatik gelir
ADMIN_EMAILS=            # Yönetici e-postaları, virgülle. Proje ekleyip token girebilen kişiler
ENCRYPTION_KEY=          # Rastgele, en az 32 karakter. Servis token'larını şifreler; kaybedersen token'ları yeniden girmen gerekir
CRON_SECRET=             # Rastgele uzun bir değer; Vercel cron isteğini doğrular
RESEND_API_KEY=          # Giriş bağlantıları ve özet mailleri için

# İsteğe bağlı
MAIL_FROM=               # Örn. "Night Watch <nobet@alanadin.com>". Boşsa onboarding@resend.dev kullanılır
APP_URL=                 # Örn. https://night-watch.vercel.app (maillerdeki bağlantılar için)
APP_TZ=Europe/Istanbul

# Vercel, GitHub, App Store ve AWS token'ları buraya yazılmaz:
# her proje için uygulamadaki Ayarlar sekmesinden girilir.
